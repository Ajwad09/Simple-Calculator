
{
  "name": "simple-calculator",
  "version": "1.0.0",
  "description": "A simple calculator",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win",
    "build-linux": "electron-builder --linux deb AppImage",
    "build-mac": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.simplecalculator.app",
    "productName": "Simple Calculator",
    "files": [
      "main.js",
      "index.html",
      "style.css",
      "script.js"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": ["deb", "AppImage"]
    },
    "mac": {
      "target": "dmg"
    }
  }
}
